{
  "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
  "kind": "Kustomization",
  "metadata": {
    "name": "norish"
  },
  "spec": {
    "commonMetadata": {
      "labels": {
        "app.kubernetes.io/name": "norish"
      }
    },
    "components": [
      "../../../../components/common/app",
      "../../../../components/homepage",
      "../../../../components/cnpg",
      "../../../../components/dragonfly",
      "../../../../components/volsync"
    ],
    "dependsOn": [
      {
        "name": "cloudnative-pg"
      },
      {
        "name": "dragonfly-operator"
      },
      {
        "name": "envoy-gateway-config"
      },
      {
        "name": "external-secrets-store"
      },
      {
        "name": "openebs"
      },
      {
        "name": "rook-ceph-cluster"
      },
      {
        "name": "volsync"
      }
    ],
    "interval": "1h",
    "patches": [
      {
        "patch": "apiVersion: helm.toolkit.fluxcd.io/v2\nkind: HelmRelease\nmetadata:\n  name: norish\nspec:\n  values:\n    route:\n      app:\n        annotations:\n          gethomepage.dev/siteMonitor: >-\n            http://norish.norish.svc.cluster.local:3000/api/v1/health",
        "target": {
          "group": "helm.toolkit.fluxcd.io",
          "kind": "HelmRelease",
          "name": "norish"
        }
      }
    ],
    "path": "kubernetes/apps/services/norish/app",
    "postBuild": {
      "substitute": {
        "APP": "norish"
      }
    },
    "prune": true,
    "sourceRef": {
      "kind": "GitRepository",
      "name": "flux-system"
    },
    "targetNamespace": "norish",
    "timeout": "10m",
    "wait": true
  }
}
