{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Auto-merge minor and patch updates after stability window",
      automerge: true,
      automergeType: "pr",
      prCreation: "immediate",
      matchUpdateTypes: ["minor", "patch"],
      minimumReleaseAge: "3 days",
      internalChecksFilter: "none",
      ignoreTests: false,
    },
    {
      description: "Auto-merge digest and pin updates",
      automerge: true,
      automergeType: "pr",
      matchUpdateTypes: ["digest", "pin", "pinDigest"],
      ignoreTests: false,
    },
    {
      description: "Require approval for major updates",
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Require approval for critical system app updates",
      matchFileNames: [
        "kubernetes/apps/system/cert-manager/**",
        "kubernetes/apps/system/cilium/**",
        "kubernetes/apps/system/csi-driver-nfs/**",
        "kubernetes/apps/system/flux-system/**",
        "kubernetes/apps/system/kubelet-csr-approver/**",
        "kubernetes/apps/system/multus/**",
        "kubernetes/apps/system/openebs/**",
        "kubernetes/apps/system/rook-ceph/**",
        "kubernetes/apps/system/snapshot-controller/**",
        "kubernetes/apps/system/tuppr/**",
        "kubernetes/apps/system/whereabouts/**",
        "talos/**",
      ],
      automerge: false,
      dependencyDashboardApproval: true,
      matchUpdateTypes: ["major", "minor", "patch", "digest", "pin", "pinDigest"],
    },
  ],
}
