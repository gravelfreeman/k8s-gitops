{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Process annotated dependencies",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: [
        "datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\n.+ (?<currentValue>[v|\\d]\\S+)"
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      customType: "regex",
      description: "Process OCI dependencies",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: ["oci://(?<depName>[^:]+):(?<currentValue>\\S+)"],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Process Alpine APK dependencies",
      managerFilePatterns: ["/kubernetes/apps/media/plex/plex/app/config/worker-init\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=custom\\.alpine-apk depName=(?<depName>\\S+) packageName=(?<packageName>\\S+) registryUrl=(?<registryUrl>\\S+)\\n\\s+fetch_pkg (?<repo>\\S+) (?<packagePrefix>\\S+)-(?<currentValue>\\d[^\\s]+)\\.apk"
      ],
      datasourceTemplate: "custom.alpine-apk",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)$",
      extractVersionTemplate: "^{{{packageName}}}-(?<version>.+)\\.apk$",
      autoReplaceStringTemplate: "# renovate: datasource=custom.alpine-apk depName={{{depName}}} packageName={{{packageName}}} registryUrl={{{registryUrl}}}\\n    fetch_pkg {{{repo}}} {{{packagePrefix}}}-{{{newValue}}}.apk",
    },
  ],
  customDatasources: {
    "alpine-apk": {
      format: "html",
    },
  },
}
