{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Process annotated dependencies",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: [
        "datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\n.+ (?<currentValue>[v|\\d]\\S+)"
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      customType: "regex",
      description: "Process OCI dependencies",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: ["oci://(?<depName>[^:]+):(?<currentValue>\\S+)"],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Process Alpine musl APK dependency",
      managerFilePatterns: ["/kubernetes/apps/media/plex/plex/app/config/worker-init\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=custom\\.alpine-apk depName=(?<depName>main/musl) packageName=(?<packageName>musl) registryUrl=(?<registryUrl>\\S+)\\n\\s+fetch_pkg (?<repo>main) (?<packagePrefix>musl)-(?<currentValue>\\d[^\\s]+)\\.apk"
      ],
      datasourceTemplate: "custom.alpine-apk",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)$",
      extractVersionTemplate: "^{{{packageName}}}-(?<version>.+)\\.apk$",
    },
    {
      customType: "regex",
      description: "Process Alpine libgcc APK dependency",
      managerFilePatterns: ["/kubernetes/apps/media/plex/plex/app/config/worker-init\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=custom\\.alpine-apk depName=(?<depName>main/libgcc) packageName=(?<packageName>libgcc) registryUrl=(?<registryUrl>\\S+)\\n\\s+fetch_pkg (?<repo>main) (?<packagePrefix>libgcc)-(?<currentValue>\\d[^\\s]+)\\.apk"
      ],
      datasourceTemplate: "custom.alpine-apk",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)$",
      extractVersionTemplate: "^{{{packageName}}}-(?<version>.+)\\.apk$",
    },
    {
      customType: "regex",
      description: "Process Alpine libstdc++ APK dependency",
      managerFilePatterns: ["/kubernetes/apps/media/plex/plex/app/config/worker-init\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=custom\\.alpine-apk depName=(?<depName>main/libstdc\\+\\+) packageName=(?<packageName>libstdc%2B%2B) registryUrl=(?<registryUrl>\\S+)\\n\\s+fetch_pkg (?<repo>main) (?<packagePrefix>libstdc\\+\\+)-(?<currentValue>\\d[^\\s]+)\\.apk"
      ],
      datasourceTemplate: "custom.alpine-apk",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)$",
      extractVersionTemplate: "^{{{packageName}}}-(?<version>.+)\\.apk$",
    },
    {
      customType: "regex",
      description: "Process Alpine libdrm APK dependency",
      managerFilePatterns: ["/kubernetes/apps/media/plex/plex/app/config/worker-init\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=custom\\.alpine-apk depName=(?<depName>main/libdrm) packageName=(?<packageName>libdrm) registryUrl=(?<registryUrl>\\S+)\\n\\s+fetch_pkg (?<repo>main) (?<packagePrefix>libdrm)-(?<currentValue>\\d[^\\s]+)\\.apk"
      ],
      datasourceTemplate: "custom.alpine-apk",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)$",
      extractVersionTemplate: "^{{{packageName}}}-(?<version>.+)\\.apk$",
    },
    {
      customType: "regex",
      description: "Process Alpine libva APK dependency",
      managerFilePatterns: ["/kubernetes/apps/media/plex/plex/app/config/worker-init\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=custom\\.alpine-apk depName=(?<depName>main/libva) packageName=(?<packageName>libva) registryUrl=(?<registryUrl>\\S+)\\n\\s+fetch_pkg (?<repo>main) (?<packagePrefix>libva)-(?<currentValue>\\d[^\\s]+)\\.apk"
      ],
      datasourceTemplate: "custom.alpine-apk",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)$",
      extractVersionTemplate: "^{{{packageName}}}-(?<version>.+)\\.apk$",
    },
    {
      customType: "regex",
      description: "Process Alpine libpciaccess APK dependency",
      managerFilePatterns: ["/kubernetes/apps/media/plex/plex/app/config/worker-init\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=custom\\.alpine-apk depName=(?<depName>main/libpciaccess) packageName=(?<packageName>libpciaccess) registryUrl=(?<registryUrl>\\S+)\\n\\s+fetch_pkg (?<repo>main) (?<packagePrefix>libpciaccess)-(?<currentValue>\\d[^\\s]+)\\.apk"
      ],
      datasourceTemplate: "custom.alpine-apk",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)$",
      extractVersionTemplate: "^{{{packageName}}}-(?<version>.+)\\.apk$",
    },
    {
      customType: "regex",
      description: "Process Alpine Intel GMMlib APK dependency",
      managerFilePatterns: ["/kubernetes/apps/media/plex/plex/app/config/worker-init\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=custom\\.alpine-apk depName=(?<depName>community/intel-gmmlib) packageName=(?<packageName>intel-gmmlib) registryUrl=(?<registryUrl>\\S+)\\n\\s+fetch_pkg (?<repo>community) (?<packagePrefix>intel-gmmlib)-(?<currentValue>\\d[^\\s]+)\\.apk"
      ],
      datasourceTemplate: "custom.alpine-apk",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)$",
      extractVersionTemplate: "^{{{packageName}}}-(?<version>.+)\\.apk$",
    },
    {
      customType: "regex",
      description: "Process Alpine Intel media driver APK dependency",
      managerFilePatterns: ["/kubernetes/apps/media/plex/plex/app/config/worker-init\\.yaml$/"],
      matchStrings: [
        "# renovate: datasource=custom\\.alpine-apk depName=(?<depName>community/intel-media-driver) packageName=(?<packageName>intel-media-driver) registryUrl=(?<registryUrl>\\S+)\\n\\s+fetch_pkg (?<repo>community) (?<packagePrefix>intel-media-driver)-(?<currentValue>\\d[^\\s]+)\\.apk"
      ],
      datasourceTemplate: "custom.alpine-apk",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-r(?<build>\\d+)$",
      extractVersionTemplate: "^{{{packageName}}}-(?<version>.+)\\.apk$",
    },
  ],
  customDatasources: {
    "alpine-apk": {
      format: "html",
    },
  },
}
