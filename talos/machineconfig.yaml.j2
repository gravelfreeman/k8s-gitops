---
version: v1alpha1
machine:
  type: {{ ENV.MACHINE_TYPE }}
  token: op://${OP_VAULT}/talos/MACHINE_TOKEN
  ca:
    crt: op://${OP_VAULT}/talos/MACHINE_CA_CRT
    {% if ENV.MACHINE_TYPE == 'controlplane' %}
    key: op://${OP_VAULT}/talos/MACHINE_CA_KEY
    {% endif %}
  features:
    apidCheckExtKeyUsage: true
    hostDNS:
      enabled: true
      resolveMemberNames: true
    kubePrism:
      enabled: true
      port: 7445
    {% if ENV.MACHINE_TYPE == 'controlplane' %}
    kubernetesTalosAPIAccess:
      enabled: true
      allowedKubernetesNamespaces:
        - actions-runner-system
        - system-upgrade
      allowedRoles: [os:admin]
    {% endif %}
    rbac: true
    stableHostname: true
  files:
    - op: overwrite
      path: /etc/nfsmount.conf
      permissions: 0o644
      content: |
        [ NFSMount_Global_Options ]
        nfsvers=4.2
        hard=True
        nconnect=16
        noatime=True
        rsize=4194304
        wsize=4194304
    - op: overwrite
      path: /etc/cri/conf.d/20-customization.part
      permissions: 0o644
      content: |
        [plugins."io.containerd.cri.v1.images"]
          discard_unpacked_layers = false
  install:
    image: factory.talos.dev/installer-secureboot/ab86bd395e263b78e5f54c800e4d319dae786d9ae25ecb129462a9e0e9491615:v1.13.0
  kernel:
    modules:
      - name: dm_mod
      - name: dm_snapshot
      - name: dm_thin_pool
      - name: i915
      - name: mei
      - name: mei_me
      - name: nbd
      - name: thunderbolt
      - name: thunderbolt_net
  kubelet:
    extraArgs:
      rotate-server-certificates: true
    extraConfig:
      serializeImagePulls: false
    image: ghcr.io/siderolabs/kubelet:v1.36.0
    nodeIP:
      validSubnets: [10.0.10.0/24]
  nodeLabels:
    intel.feature.node.kubernetes.io/gpu: "true"
    topology.kubernetes.io/region: ms01
  sysctls:
    fs.inotify.max_user_instances: 8192
    fs.inotify.max_user_watches: 1048576
    net.core.default_qdisc: fq
    net.core.rmem_max: 67108864
    net.core.wmem_max: 67108864
    net.ipv4.ping_group_range: 0 2147483647
    net.ipv4.tcp_congestion_control: bbr
    net.ipv4.tcp_fastopen: 3
    net.ipv4.tcp_mtu_probing: 1
    net.ipv4.tcp_notsent_lowat: 131072
    net.ipv4.tcp_rmem: 4096 87380 33554432
    net.ipv4.tcp_slow_start_after_idle: 0
    net.ipv4.tcp_window_scaling: 1
    net.ipv4.tcp_wmem: 4096 65536 33554432
    sunrpc.tcp_max_slot_table_entries: 128
    sunrpc.tcp_slot_table_entries: 128
    user.max_user_namespaces: 11255
  time:
    servers:
      - 0.ca.pool.ntp.org
      - 1.ca.pool.ntp.org
  udev:
    rules:
      - ACTION=="add", SUBSYSTEM=="thunderbolt", ATTR{authorized}=="0", ATTR{authorized}="1"
      - SUBSYSTEM=="drm", KERNEL=="card*", GROUP="44", MODE="0660"
      - SUBSYSTEM=="drm", KERNEL=="renderD*", GROUP="44", MODE="0660"
cluster:
  clusterName: ms01
  controlPlane:
    endpoint: https://10.0.10.100:6443
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: true
  id: op://${OP_VAULT}/talos/CLUSTER_ID
  network:
    cni:
      name: none
    podSubnets: [172.20.0.0/16]
    serviceSubnets: [172.30.0.0/16]
  secret: op://${OP_VAULT}/talos/CLUSTER_SECRET
  token: op://${OP_VAULT}/talos/CLUSTER_TOKEN
  ca:
    crt: op://${OP_VAULT}/talos/CLUSTER_CA_CRT
    {% if ENV.MACHINE_TYPE == 'controlplane' %}
    key: op://${OP_VAULT}/talos/CLUSTER_CA_KEY
    {% endif %}
  {% if ENV.MACHINE_TYPE == 'controlplane' %}
  aggregatorCA:
    crt: op://${OP_VAULT}/talos/CLUSTER_AGGREGATORCA_CRT
    key: op://${OP_VAULT}/talos/CLUSTER_AGGREGATORCA_KEY
  allowSchedulingOnControlPlanes: true
  apiServer:
    certSANs: ["k8s.{% raw %}{{ op://${OP_VAULT}/flux-common/DOMAIN_0 }}{% endraw %}", 10.0.10.100]
    extraArgs:
      enable-aggregator-routing: true
      enable-admission-plugins: NodeRestriction,MutatingAdmissionPolicy
    image: registry.k8s.io/kube-apiserver:v1.36.0
  controllerManager:
    extraArgs:
      bind-address: 0.0.0.0
    image: registry.k8s.io/kube-controller-manager:v1.36.0
  etcd:
    advertisedSubnets: [10.0.10.0/24]
    ca:
      crt: op://${OP_VAULT}/talos/CLUSTER_ETCD_CA_CRT
      key: op://${OP_VAULT}/talos/CLUSTER_ETCD_CA_KEY
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
  proxy:
    disabled: true
    image: registry.k8s.io/kube-proxy:v1.36.0
  scheduler:
    config:
      apiVersion: kubescheduler.config.k8s.io/v1
      kind: KubeSchedulerConfiguration
      profiles:
        - schedulerName: default-scheduler
          plugins:
            score:
              disabled:
                - name: ImageLocality
          pluginConfig:
            - name: PodTopologySpread
              args:
                defaultingType: List
                defaultConstraints:
                  - maxSkew: 1
                    topologyKey: kubernetes.io/hostname
                    whenUnsatisfiable: ScheduleAnyway
    extraArgs:
      bind-address: 0.0.0.0
    image: registry.k8s.io/kube-scheduler:v1.36.0
  secretboxEncryptionSecret: op://${OP_VAULT}/talos/CLUSTER_SECRETBOXENCRYPTIONSECRET
  serviceAccount:
    key: op://${OP_VAULT}/talos/CLUSTER_SERVICEACCOUNT_KEY
  {% endif %}
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 10m
---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
provisioning:
  diskSelector:
    match: system_disk
  maxSize: 128GiB
---
apiVersion: v1alpha1
kind: RawVolumeConfig
name: openebs-lvm
provisioning:
  diskSelector:
    match: system_disk
  maxSize: 640GiB
