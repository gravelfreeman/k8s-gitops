Host github.com
  HostName github.com
  User git
  IdentityAgent __SSH_AUTH_SOCK__
  IdentityFile ~/.ssh/github-auth.pub
  IdentitiesOnly yes
  PreferredAuthentications publickey
  StrictHostKeyChecking accept-new
  UserKnownHostsFile ~/.ssh/known_hosts

Host localhost 127.0.0.1 ::1
  IdentitiesOnly yes
  PreferredAuthentications publickey
