{
    "name": "k8s-gitops",
    "build": { "dockerfile": "Dockerfile" },
    "features": {
        "ghcr.io/devcontainers/features/aws-cli:1": {},
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "installOhMyZsh": true,
            "installOhMyZshConfig": true,
            "username": "zed"
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "minikube": "none"
        },
        "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
            "packages": "command-not-found,file,fzf,jq,libimage-exiftool-perl,netcat-openbsd,python3,python3-pip,python3-venv,restic,ripgrep,sshfs,tree,unzip,xz-utils,zip,zsh,zsh-autosuggestions,zsh-syntax-highlighting,zstd"
        },
        "ghcr.io/devcontainers-extra/features/cloudflared:1": {},
        "ghcr.io/devcontainers-extra/features/go-task:1": {},
        "ghcr.io/devcontainers-extra/features/helmfile:1": {},
        "ghcr.io/devcontainers-extra/features/talosctl:1": {},
        "ghcr.io/devcontainer-community/devcontainer-features/k9scli.io:1": {},
        "ghcr.io/devcontainer-community/devcontainer-features/yq:1": {},
        "ghcr.io/flexwie/devcontainer-features/op:1": {},
        "ghcr.io/jsburckhardt/devcontainer-features/flux:1": {},
        "ghcr.io/rio/features/kustomize:1": {}
    },
    "mounts": [
        "source=${localEnv:HOME}/.cache/k8s-gitops/ssh-agent.sock,target=/tmp/ssh-agent.sock,type=bind",
        "source=${localEnv:HOME}/.cache/k8s-gitops,target=/tmp/host-secrets,type=bind",
        "source=${localEnv:HOME}/.cache/k8s-gitops/talos,target=/tmp/talos,type=bind",
        "source=${localEnv:HOME}/.gitconfig,target=/tmp/host.gitconfig,type=bind,readonly",
        "source=${localEnv:HOME}/.codex,target=/home/zed/.codex,type=bind"
    ],
    "runArgs": [
        "--device=/dev/fuse",
        "--cap-add=SYS_ADMIN",
        "--security-opt=apparmor:unconfined"
    ],
    "containerEnv": {
        "SHELL": "/bin/zsh",
        "DEVCONTAINER": "true",
        "K8S_GITOPS_DEVCONTAINER": "true",
        "SSH_AUTH_SOCK": "/tmp/ssh-agent.sock",
        "PATH": "/home/zed/.local/bin:/home/zed/.krew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "MINIJINJA_CONFIG_FILE": "${containerWorkspaceFolder}/.devcontainer/.config/.minijinja.toml",
        "KUBECONFIG": "/home/zed/.kube/config",
        "TALOSCONFIG": "/home/zed/.talos/config"
    },
    "remoteUser": "zed",
    "containerUser": "zed",
    "updateRemoteUserUID": false,
    "userEnvProbe": "loginInteractiveShell",
    "initializeCommand": "bash ${localWorkspaceFolder}/.devcontainer/scripts/initializeCommand.sh ${localWorkspaceFolder}",
    "onCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/scripts/onCreateCommand.sh ${containerWorkspaceFolder}",
    "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/scripts/postCreateCommand.sh ${containerWorkspaceFolder}"
}
